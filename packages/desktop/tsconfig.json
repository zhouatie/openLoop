{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@openloop/core/media-mime": ["../core/src/constants/media-mime.ts"],
      "@openloop/core/task-summary": ["../core/src/store/task-summary.ts"],
      "@openloop/core/agent-format": ["../core/src/agent/agent-format.ts"],
      "@openloop/core/agent-events": ["../core/src/agent/agent-events.ts"],
      "@openloop/core/types": ["../core/src/types/index.ts"]
    }
  },
  "include": ["src"]
}
