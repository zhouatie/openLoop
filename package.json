{
  "name": "openloop-monorepo",
  "version": "0.8.0",
  "private": true,
  "description": "Desktop automation platform: Markdown pipelines, worktree sandboxes, agent workbench, plugin slots and QA automation",
  "author": "openLoop contributors",
  "license": "MIT",
  "homepage": "https://github.com/zhouatie/openLoop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhouatie/openLoop.git"
  },
  "bugs": {
    "url": "https://github.com/zhouatie/openLoop/issues"
  },
  "keywords": [
    "automation",
    "pipeline",
    "agent",
    "orchestration",
    "worktree",
    "electron",
    "qa-automation",
    "midscene"
  ],
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "main": "packages/desktop/dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/clean-ports.js",
    "dev": "node scripts/dev.js",
    "clean:ports": "node scripts/clean-ports.js",
    "clean:ports:all": "node scripts/clean-ports.js --all",
    "service:start": "node packages/core/dist/server-cli.js",
    "service:restart": "node scripts/clean-ports.js --all && node packages/core/dist/server-cli.js",
    "dev:browser": "pnpm run dev",
    "dev:desktop": "node scripts/dev.js --desktop",
    "desktop:start": "pnpm --filter @openloop/desktop start",
    "db:fork": "node scripts/db-fork.js",
    "pipeline:pull": "node scripts/sync-pipelines.js pull",
    "pipeline:push": "node scripts/sync-pipelines.js push",
    "pipeline:check": "node scripts/sync-pipelines.js check",
    "pipeline:run": "node scripts/run-pipeline.js",
    "build:core": "pnpm --filter @openloop/core build",
    "build:cli": "pnpm --filter @openloop/cli build",
    "build:desktop": "pnpm --filter @openloop/desktop build",
    "build:app": "pnpm run build:core && pnpm run build:desktop",
    "build": "pnpm -r build",
    "pack": "node scripts/pack.js",
    "pack:install": "node scripts/pack.js --install",
    "pack:mac": "node scripts/pack.js --current",
    "pack:all": "node scripts/pack.js --all",
    "electron:build": "pnpm run build && electron-builder",
    "electron:build:mac": "pnpm run build && electron-builder --mac",
    "electron:install:local": "node scripts/install-mac.js",
    "start:prod": "node packages/core/dist/server-cli.js",
    "deploy": "bash scripts/deploy.sh",
    "deploy:docker": "docker compose up -d --build",
    "cli": "node packages/cli/dist/index.js",
    "docs:check": "node scripts/check-docs-links.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3"
  }
}
