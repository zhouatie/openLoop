{
  "name": "openloop-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop Automation Platform with Visual Orchestration, Plugins, Agent & CLI integration",
  "author": "zhouatie",
  "main": "packages/desktop/dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/clean-ports.js",
    "dev": "concurrently -k -n \"core,web\" -c \"cyan,magenta\" \"pnpm --filter @openloop/core start\" \"pnpm --filter @openloop/desktop dev\"",
    "clean:ports": "node scripts/clean-ports.js",
    "dev:browser": "pnpm run dev",
    "dev:desktop": "concurrently -k -n \"core,web,electron\" -c \"cyan,magenta,green\" \"pnpm --filter @openloop/core start\" \"pnpm --filter @openloop/desktop dev\" \"wait-on tcp:5173 && pnpm --filter @openloop/desktop start\"",
    "desktop:start": "pnpm --filter @openloop/desktop start",
    "build:core": "pnpm --filter @openloop/core build",
    "build:cli": "pnpm --filter @openloop/cli build",
    "build:desktop": "pnpm --filter @openloop/desktop build",
    "build": "pnpm -r build",
    "electron:build": "pnpm run build && electron-builder",
    "electron:build:mac": "pnpm run build && electron-builder --mac",
    "start:prod": "node packages/core/dist/server-cli.js",
    "deploy": "bash scripts/deploy.sh",
    "deploy:docker": "docker compose up -d --build",
    "cli": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3"
  }
}
